{
  "name": "Omniagent \u2014 The Winback",
  "nodes": [
    {
      "id": "wb-0001",
      "name": "Every Tuesday 10:00",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        200,
        300
      ],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 10 * * 2"
            }
          ]
        }
      }
    },
    {
      "id": "wb-0002",
      "name": "Fetch Lapsed Customers",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        420,
        300
      ],
      "parameters": {
        "url": "YOUR_LAPSED_CUSTOMERS_WEBHOOK_URL",
        "sendQuery": true,
        "specifyQuery": "keypair",
        "queryParameters": {
          "parameters": [
            {
              "name": "inactiveDays",
              "value": "60"
            },
            {
              "name": "limit",
              "value": "25"
            }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "wb-0003",
      "name": "One Item Per Customer",
      "type": "n8n-nodes-base.splitOut",
      "typeVersion": 1,
      "position": [
        640,
        300
      ],
      "parameters": {
        "fieldToSplitOut": "customers",
        "options": {}
      }
    },
    {
      "id": "wb-0004",
      "name": "Skip Recently Nudged",
      "type": "n8n-nodes-base.filter",
      "typeVersion": 2.2,
      "position": [
        860,
        300
      ],
      "parameters": {
        "conditions": {
          "combinator": "and",
          "conditions": [
            {
              "leftValue": "={{ $json.lastWinbackAt || '' }}",
              "operator": {
                "operation": "notEquals",
                "type": "string"
              },
              "rightValue": "={{ $now.toFormat('yyyy-MM') }}"
            }
          ],
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose"
          }
        },
        "options": {}
      }
    },
    {
      "id": "wb-0005",
      "name": "Compose Winback",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 2,
      "position": [
        1080,
        300
      ],
      "parameters": {
        "promptType": "define",
        "text": "=Customer: {{ JSON.stringify($json) }}",
        "options": {
          "maxIterations": 5,
          "systemMessage": "You write ONE short, personal WhatsApp check-in for YOUR BUSINESS to a customer who hasn't been back in a while.\n\nRules:\n1. Two sentences max. Reference their last visit or last purchase from the data given \u2014 nothing invented.\n2. No discounts, no coupons, no pressure. The tone is \"we noticed, we care\", not marketing.\n3. End with a genuine, easy question they can answer in one word.\n4. Outbound messages beyond WhatsApp's 24-hour window must be sent as an approved template \u2014 this text fills that template's variable slot.\n5. Output the message text alone \u2014 nothing else."
        }
      }
    },
    {
      "id": "wb-0006",
      "name": "OpenAI Chat Model",
      "type": "@n8n/n8n-nodes-langchain.lmChatOpenAi",
      "typeVersion": 1.2,
      "position": [
        1080,
        520
      ],
      "parameters": {
        "model": {
          "__rl": true,
          "mode": "list",
          "value": "gpt-4.1",
          "cachedResultName": "gpt-4.1"
        },
        "options": {
          "maxTokens": -1,
          "temperature": 0.5
        }
      }
    },
    {
      "id": "wb-0007",
      "name": "Send Winback",
      "type": "n8n-nodes-base.whatsApp",
      "typeVersion": 1,
      "position": [
        1320,
        300
      ],
      "parameters": {
        "operation": "send",
        "messageType": "text",
        "phoneNumberId": "YOUR_PHONE_NUMBER_ID",
        "recipientPhoneNumber": "={{ $('One Item Per Customer').item.json.phone }}",
        "textBody": "={{ $json.output }}",
        "additionalFields": {}
      }
    },
    {
      "id": "wb-0008",
      "name": "Log Winback",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1540,
        300
      ],
      "parameters": {
        "url": "YOUR_WINBACK_LOG_WEBHOOK_URL",
        "method": "POST",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"customerId\": \"{{ $('One Item Per Customer').item.json.id }}\",\n  \"phone\": \"{{ $('One Item Per Customer').item.json.phone }}\",\n  \"sentAt\": \"{{ $now.toISO() }}\"\n}",
        "options": {}
      }
    }
  ],
  "connections": {
    "Every Tuesday 10:00": {
      "main": [
        [
          {
            "node": "Fetch Lapsed Customers",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Fetch Lapsed Customers": {
      "main": [
        [
          {
            "node": "One Item Per Customer",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "One Item Per Customer": {
      "main": [
        [
          {
            "node": "Skip Recently Nudged",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Skip Recently Nudged": {
      "main": [
        [
          {
            "node": "Compose Winback",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Compose Winback": {
      "main": [
        [
          {
            "node": "Send Winback",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "OpenAI Chat Model": {
      "ai_languageModel": [
        [
          {
            "node": "Compose Winback",
            "type": "ai_languageModel",
            "index": 0
          }
        ]
      ]
    },
    "Send Winback": {
      "main": [
        [
          {
            "node": "Log Winback",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "pinData": {},
  "meta": {
    "templateCredsSetupCompleted": false
  },
  "tags": [
    {
      "name": "whatsapp"
    },
    {
      "name": "night-shift"
    },
    {
      "name": "cron"
    },
    {
      "name": "assembly"
    }
  ]
}