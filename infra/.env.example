# Copy to .env and fill in. Never commit .env.

# The domain your engine answers on, e.g. engine.omniagent.ai
# (DNS A record must point at this server before first boot — Caddy
# fetches the TLS certificate automatically on startup.)
N8N_DOMAIN=engine.example.com

# Generate once, keep forever — encrypts every stored credential.
# Lose it and every credential must be re-entered.
#   openssl rand -hex 32
N8N_ENCRYPTION_KEY=

TIMEZONE=Pacific/Honolulu

POSTGRES_DB=n8n
POSTGRES_USER=n8n
# openssl rand -hex 24
POSTGRES_PASSWORD=
